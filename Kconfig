menuconfig ZMK_PSP_JOYSTICK
    bool "Enable psp-joystick feature"
    help
      Enable PSP thumbstick state, Studio RPC, and the ADC driver.

if ZMK_PSP_JOYSTICK

config ZMK_PSP_JOYSTICK_DRIVER
    bool "PSP joystick ADC input driver"
    default y if DT_HAS_TOKYO2006_PSP_JOYSTICK_ENABLED
    depends on INPUT && ADC

config ZMK_PSP_JOYSTICK_DEDICATED_WORKQUEUE
    bool "Use a dedicated workqueue for joystick sampling"
    default y
    depends on ZMK_PSP_JOYSTICK_DRIVER
    help
      Run the joystick sampling work on its own workqueue instead of the
      shared system workqueue. On a keyboard the TPS43 trackpad, RGB and
      other drivers also use the system workqueue; a slow I2C transfer can
      delay joystick samples and make the pointer stutter.

config ZMK_PSP_JOYSTICK_WORKQUEUE_STACK_SIZE
    int "Dedicated workqueue stack size"
    default 2048
    depends on ZMK_PSP_JOYSTICK_DEDICATED_WORKQUEUE

config ZMK_PSP_JOYSTICK_WORKQUEUE_PRIORITY
    int "Dedicated workqueue priority"
    default 0
    depends on ZMK_PSP_JOYSTICK_DEDICATED_WORKQUEUE

config ZMK_PSP_JOYSTICK_STUDIO_RPC
    bool "Enable psp-joystick custom Studio RPC"
    depends on ZMK_STUDIO

config ZMK_PSP_JOYSTICK_SPLIT_RELAY
    bool "Relay psp-joystick state to split peripherals"
    depends on ZMK_SPLIT && ZMK_SPLIT_RELAY_EVENT && ZMK_SPLIT_BLE
    help
      Requires the BLE split transport. At the pinned ZMK revision,
      relay events are not implemented for the wired split transport,
      so this option is unavailable on a wired-only central.

module = ZMK_PSP_JOYSTICK
module-str = ZMK_PSP_JOYSTICK
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif
