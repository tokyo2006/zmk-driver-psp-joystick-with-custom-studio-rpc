config ZMK_PSP_JOYSTICK
    bool "Enable psp-joystick feature"

if ZMK_PSP_JOYSTICK

config ZMK_PSP_JOYSTICK_STUDIO_RPC
    bool "Enable psp-joystick feature custom Studio RPC"
    depends on ZMK_STUDIO

# The split-relay sample (src/split/template_relay.c) has no Kconfig of its
